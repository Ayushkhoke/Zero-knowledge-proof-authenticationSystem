generator client {
  provider = "prisma-client-js"
  output   = "client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  role      UserRole @default(USER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  // ZKP authentication fields
  zkpCommitment String? @map("zkp_commitment") // Hash of the user's secret (public commitment)
  zkpPublicKey  String? @map("zkp_public_key") // Public key for verification

  // Blockchain fields
  blockchainAddress String? @map("blockchain_address") // User's commitment stored on blockchain
  transactionHash   String? @map("transaction_hash") // Transaction hash for commitment storage
  blockNumber       Int?    @map("block_number") // Block number where commitment was stored
  chainId           Int?    @map("chain_id") // Chain ID (11155111 for Sepolia)

  @@map("users")
}

model ZKPCircuit {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  circuitName     String   @unique @map("circuit_name") // e.g., "auth_circuit"
  wasmPath        String   @map("wasm_path") // Path to compiled circuit wasm
  zkeyPath        String   @map("zkey_path") // Path to proving key
  verificationKey String   @map("verification_key") // JSON string of verification key
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  @@map("zkp_circuits")
}

model ZKPProofAttempt {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String
  proof         String // JSON string of the proof
  publicSignals String   @map("public_signals") // JSON string of public signals
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("zkp_proof_attempts")
}

enum UserRole {
  ADMIN
  USER
}
