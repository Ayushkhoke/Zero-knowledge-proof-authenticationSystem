PORT=3001
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=clientId
GOOGLE_CLIENT_SECRET=secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

DATABASE_URL=mongoUrl

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT="465"
SMTP_USER="username"
SMTP_PASSWORD="password"
MAIL_FROM="from@example.com"
SMTP_FROM_NAME="From Name"

# Gemini
GEMINI_API_KEY=your_gemini_api_key 
GEMINI_BASE_URL=https://api.gemini.com/v1

# Blockchain Configuration (Sepolia Testnet)
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/be9010d423e74ec38778b2e43ad58a29
BLOCKCHAIN_PRIVATE_KEY=your-private-key-here-without-0x-prefix
BLOCKCHAIN_CONTRACT_ADDRESS=deployed-contract-address-after-deployment
BLOCKCHAIN_CHAIN_ID=11155111

# Note: To get Sepolia RPC URL:
# 1. Create account at https://infura.io or https://alchemy.com
# 2. Create a new project
# 3. Get your Sepolia testnet endpoint URL
#
# To get test ETH for Sepolia:
# Visit https://sepoliafaucet.com or https://faucet.sepolia.dev